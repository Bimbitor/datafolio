---
// Layout mínimo de la versión base (F-000). Se reemplaza en F-001.
interface Props {
  lang: "es" | "en";
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
// BASE_URL = "/datafolio/" en producción; nunca escribir rutas absolutas a mano.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const esHref = base;
const enHref = `${base}en/`;
const alt = lang === "es" ? { lang: "en", href: enHref } : { lang: "es", href: esHref };
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(esHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(esHref, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="color-scheme" content="light dark" />
    <style is:global>
      :root {
        --bg: #ffffff;
        --text: #0f172a;
        --muted: #475569;
        --accent: #0f766e;
        --border: #e2e8f0;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0f14;
          --text: #e6edf3;
          --muted: #9aa7b4;
          --accent: #5eead4;
          --border: #243041;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        line-height: 1.6;
        padding: 24px 16px;
      }
      main { max-width: 640px; width: 100%; }
      a { color: var(--accent); }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <slot />
      <p class="lang"><a href={alt.href} hreflang={alt.lang} lang={alt.lang}>{alt.lang === "en" ? "English" : "Español"}</a></p>
    </main>
    <style>
      .lang { margin-top: 2rem; font-family: var(--mono); font-size: 0.875rem; }
    </style>
  </body>
</html>
