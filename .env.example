# Plantilla de variables de entorno. SOLO NOMBRES.
#
# Ningun valor se escribe aqui ni en ningun otro archivo del repositorio, que es publico.
# Los valores viven unicamente en las variables de entorno de la plataforma de despliegue.
# El gancho de pre-commit bloquea el commit si detecta un valor real.
#
# Contrato completo en specs/001-sitio-base/contracts/http.md, seccion 6.

# --- Las lee solo el servicio de la API ---------------------------------------
# Direccion del proyecto de datos.
SUPABASE_URL=
# Clave de servicio, para escribir en la tabla de salud. Nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Cuenta de correo que envia los avisos.
SMTP_USER=
# Contrasena de aplicacion de esa cuenta.
SMTP_PASSWORD=
# Direccion que recibe los avisos de fallo. NO es la direccion publica de contacto.
ADMIN_EMAIL=

# Secreto que la plataforma envia al disparar la comprobacion programada. Cadena aleatoria
# de 16 caracteres o mas. Lo generas tu; no lo escribas en ningun archivo del repositorio.
CRON_SECRET=

# --- Las lee solo el sitio ----------------------------------------------------
# Dominio publico, para construir canonical y hreflang.
SITE_URL=
# Direccion publica del titular, para el enlace de correo del pie.
PUBLIC_CONTACT_EMAIL=
