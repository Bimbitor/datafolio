---
import Base from "../../layouts/Base.astro";
import ContenidoPendiente from "../../components/ContenidoPendiente.astro";
import { textos } from "../../i18n/textos";
import type { Idioma } from "../../i18n/rutas";

const idioma: Idioma = "es";
const t = textos[idioma];
---

<Base idioma={idioma} clave="experiencia">
  <h1 class="font-display text-display-l text-text">{t.secciones.experiencia}</h1>
  <div class="mt-8">
    <ContenidoPendiente idioma={idioma} />
  </div>
</Base>
