{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-on-write.mjs",
            "timeout": 15,
            "statusMessage": "Formateando con Prettier"
          }
        ]
      }
    ]
  }
}
